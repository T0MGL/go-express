# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth
JWT_SECRET=
SUPABASE_JWT_SECRET=

# Admin API token (optional, for CI/CD or external integrations)
ADMIN_API_TOKEN=

# Email (stub for now)
RESEND_API_KEY=
EMAIL_FROM=GoExpress <envios@goexpressparaguay.com>

# WhatsApp Cloud API (Meta)
# Outbound-only: la app dispara templates pre-aprobados al cambiar el estado del envio.
# Si META_WA_TOKEN o META_WA_PHONE_NUMBER_ID estan vacios, el canal queda deshabilitado
# (los intentos se loguean como 'descartado' en notificaciones_log y el email sigue funcionando).
# Pasos de setup en docs/notification-templates.md seccion "Setup Meta WhatsApp Cloud API".
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_GRAPH_VERSION=v22.0
# Solo necesario si exponemos /api/public/webhooks/whatsapp para verificacion Meta.
# Generar un string aleatorio largo y configurarlo identico en Meta App Dashboard.
META_WA_VERIFY_TOKEN=
# App secret de la Meta App (Settings > Basic > App Secret). Se usa para validar
# la firma HMAC-SHA256 (header X-Hub-Signature-256) de cada POST que Meta hace al
# webhook. Sin este valor, los POST se aceptan pero la firma no se verifica y se
# loguea warn. En produccion debe estar seteado.
META_APP_SECRET=

# App
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:8080
API_RATE_LIMIT=100

# Tracking
TRACKING_PREFIX=GE
TRACKING_YEAR=2026

# Test DB local (stack Supabase local via CLI, JAMAS prod)
# Setup completo y deterministico: docs/test-db-local.md
# Con estos seteados, npm test corre contra el stack local (scripts/run-tests.mjs los usa
# para override de DATABASE_URL/SUPABASE_URL y el guard anti-prod deja pasar).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_SUPABASE_URL=http://127.0.0.1:54321
# keys del stack local (supabase status las imprime; NO son secretos de prod)
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_ANON_KEY=

# Suite de invariantes (npm run test:invariants): BEGIN/ROLLBACK sobre el schema real.
# Local: el mismo Postgres del stack de test. Prod: SOLO pooler session (puerto 5432,
# aws-1-us-east-1.pooler.supabase.com), jamas el transaction pooler 6543 (los guards por GUC
# dependen de semantica de sesion).
INVARIANT_DATABASE_URL=
